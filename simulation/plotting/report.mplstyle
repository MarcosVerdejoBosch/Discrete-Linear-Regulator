# Shared publication style, configured at final document size.
font.family: DejaVu Sans
font.size: 9
axes.labelsize: 9
axes.titlesize: 10
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.frameon: False
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.axisbelow: True
axes.grid: True
grid.color: 0.88
grid.linewidth: 0.45
lines.linewidth: 1.2
xtick.direction: out
ytick.direction: out
xtick.major.width: 0.6
ytick.major.width: 0.6
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path
path.simplify: False
