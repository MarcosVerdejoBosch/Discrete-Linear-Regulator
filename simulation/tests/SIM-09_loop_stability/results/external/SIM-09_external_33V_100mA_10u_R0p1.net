* SIM-09 | 33V | stepped voltage/current injection
* Original circuit placement and wiring. Auxiliary circuits replaced by fixed DC bias.
* Run this sheet: step 1 = voltage (lg=-1); step 2 = current (lg=+1).
.model D D
.lib standard.dio
.model NPN NPN
.model PNP PNP
.lib standard.bjt
.model NJF NJF
.model PJF PJF
.lib standard.jft
.model NMOS NMOS
.model PMOS PMOS
.lib standard.mos
.lib TL431.sub
.lib CA3096.lib
.lib opamp.lib
.lib phil_fet.lib
.param lg = 0 ; zero value turns off probe
.step param lg list -1 1
.lib nat_semi.lib
.lib phil_bjt.lib
.lib darlngtn.lib
.lib irf7328.spi
.lib pwrbjt.lib
.lib LM311.sub
.inc scr.txt
.param VOUTNOM=5
.param TOL=0.02
.param VOUTMIN = {VOUTNOM*(1-TOL)}
.param VBATDC=12
.param RLOADVAL=33
.param VSW_VT=2.5
.model SWLOAD SW(Ron=10m Roff=1e9 Vt={VSW_VT} Vh=-0.2)
.param VINTEST=8
.temp 27
.lib AO3401A.mod
.lib phil_fet.lib
.lib LTC1044.sub
.lib TL431.sub
.ac dec 500 1 60Meg
.loadbias SIM-09_loop_33V.bias
.options srcsteps=0
