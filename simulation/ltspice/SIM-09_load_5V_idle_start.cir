* block symbol definitions
.subckt lg_single A B
Ii 0 X AC {u(lg_single)}
Vi X A AC {u(-lg_single)}
VBUFFER B X 0
.ends lg_single

.model D D
.lib standard.dio
.model NPN NPN
.model PNP PNP
.lib standard.bjt
.model NJF NJF
.model PJF PJF
.lib standard.jft
.model NMOS NMOS
.model PMOS PMOS
.lib standard.mos
.lib TL431.sub
* .dc V3 0 20 100m
* .ac dec 20 0.1 60Meg
.lib CA3096.lib
.lib opamp.lib
* .dc V10 10m 150
.lib phil_fet.lib
.param lg = 0 ; zero value turns off probe
* .step param lg list -1 1
.lib nat_semi.lib
.lib phil_bjt.lib
.lib darlngtn.lib
.lib irf7328.spi
.lib pwrbjt.lib
* UVLO
* OVLO
* TIME DELAY
* POLARITY PROTECTION + SLOW START
* VREF SEQUENCER
* LDO ENABLE - UVLO/OVLO AND TIME DELAY\nADDITIONAL LED INDICATOR
* VREF REGULATOR
* IRF4905
* SHUNT BOOST
.lib LM311.sub
.inc scr.txt
* FUSE
* Diodo se coloca en caso de OVLO = True y el Feedback \nquiere seguir a la referencia de 2.5V pero Vout = 0V entonces el Ampli \nde Error compensa haciendo circular una corriente excesiva a través\ndel Buffer entre Par Diferencial y Emisor Común.
* VCTRL se justifica en el transistor de paso debido a que valores\nelevados de VIN, durante el encedido, pueden generar transitorios \nperjudiciales sobre la carga.
* El jfet cumple la función de definir la tensión GND sobre la salida\npara evitar valores de tensión flotantes debido a las cargas de los\ncapacitores.
; ---------------------------
; Global parameters (common)
; ---------------------------
.param VOUTNOM=5
.param TOL=0.02
.param VOUTMIN = {VOUTNOM*(1-TOL)}
; Default conditions (edit as needed)
.param VBATDC=12
.param RLOADVAL=5
.param VSW_VT=2.5
.model SWLOAD SW(Ron=10m Roff=1e9 Vt={VSW_VT} Vh=-0.2)
.param VINTEST=8
.temp 27
.lib AO3401A.mod
.lib phil_fet.lib
.lib LTC1044.sub
.lib TL431.sub
.backanno
VEE_BIAS VEE 0 7.97349811347
VCTRL_BIAS VCTRL 0 7.95846166042
VREF_BIAS VREF 0 2.47381949425
VEN_BIAS TTL 0 7.22622648318
VDBL_BIAS VDOBL 0 14.9
.tran 0 10m 0 200n uic
.savebias SIM-09_load_5V_idle.bias time=10m
.options plotwinsize=0
.end
