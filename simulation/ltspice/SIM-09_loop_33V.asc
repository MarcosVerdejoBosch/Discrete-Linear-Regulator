TEXT 0 3000 Left 2 !.model D D\n.lib standard.dio\n.model NPN NPN\n.model PNP PNP\n.lib standard.bjt\n.model NJF NJF\n.model PJF PJF\n.lib standard.jft\n.model NMOS NMOS\n.model PMOS PMOS\n.lib standard.mos\n.lib TL431.sub\n.lib CA3096.lib\n.lib opamp.lib\n.lib phil_fet.lib\n.param lg = 0 ; zero value turns off probe\n.step param lg list -1 1\n.lib nat_semi.lib\n.lib phil_bjt.lib\n.lib darlngtn.lib\n.lib irf7328.spi\n.lib pwrbjt.lib\n.lib LM311.sub\n.inc scr.txt\n.param VOUTNOM=5\n.param TOL=0.02\n.param VOUTMIN = {VOUTNOM*(1-TOL)}\n.param VBATDC=12\n.param RLOADVAL=3.3\n.param VSW_VT=2.5\n.model SWLOAD SW(Ron=10m Roff=1e9 Vt={VSW_VT} Vh=-0.2)\n.param VINTEST=8\n.temp 27\n.lib AO3401A.mod\n.lib phil_fet.lib\n.lib LTC1044.sub\n.lib TL431.sub\n.ac dec 200 1 60Meg\n.loadbias SIM-09_loop_33V.bias\n.options srcsteps=0
TEXT 3400 -1960 Left 3 ;Simulation notes
TEXT 3400 -1880 Left 2 ;At top level set lg_single = lg\n.param lg_single = lg <- Done automatically at symbol\n\n.param lg = 0 ; zero value turns off probe\n.step param lg list -1 1\n\nStep 1: voltage injection. Step 2: current injection.
